NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the browser. Used for privileged operations
# (e.g. background jobs) that must bypass RLS. Leave unset unless needed.
# SUPABASE_SERVICE_ROLE_KEY=

# AI provider abstraction (Phase 4) — resume tailoring, cover letters, and
# the Job Search Assistant. Set exactly one; ANTHROPIC_API_KEY takes
# priority if both are set. Every AI feature degrades gracefully (a clear
# "not configured" state) when neither is set.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Adzuna job aggregator (title-based search across many employers/boards per
# country) — free tier signup at https://developer.adzuna.com. Powers the
# "Adzuna (job title search)" job source; searches use the titles/location
# from your active Job Search Profile. Leave unset to disable — the source
# will show a clear "not configured" sync error instead of failing silently.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
